# ==============================================================================
# Apache Configuration - Ritwik Sachdeva Portfolio & CMS
# ==============================================================================

RewriteEngine On
RewriteBase /

# 1. Protect Sensitive Files & Directories
<FilesMatch "(\.sql|\.log|\.env|composer\.(json|lock)|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect database directory
RewriteRule ^database/ - [F,L]

# 2. 301 Redirects for Legacy Service URLs
RewriteRule ^service-fractional-cmo\.html$ service-best-marketing-consultant.html [R=301,L]
RewriteRule ^service-brand-strategy\.html$ service-graphic-designer.html [R=301,L]
RewriteRule ^service-seo-consulting\.html$ service-seo-expert.html [R=301,L]
RewriteRule ^service-b2b-lead-generation\.html$ service-performance-marketing.html [R=301,L]
RewriteRule ^service-content-marketing\.html$ service-smo-services.html [R=301,L]
RewriteRule ^service-marketing-analytics\.html$ service-performance-marketing.html [R=301,L]

# 3. Clean URLs for Blog CMS
# /blog -> blog.php
RewriteRule ^blog/?$ blog.php [L,QSA]

# /blog/:slug -> blog-detail.php?slug=:slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-detail.php?slug=$1 [L,QSA]

# 4. Clean URLs for Admin Portal
# /admin -> admin/index.php
RewriteRule ^admin/?$ admin/index.php [L,QSA]

# 5. Security Headers (where supported)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. UTF-8 Encoding
AddDefaultCharset UTF-8
